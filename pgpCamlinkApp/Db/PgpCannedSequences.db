#
# PgpCannedSequences.db
#
# Contains various sequence record's to aid in changing timing modes
#	
# Required macros:
#	PGP				- Prefix for pgpRogue IOC

# Select LCLS-I Timing
record( seq, "$(PGP):SeqLcls1Timing" )
{
	field( DESC, "Select LCLS-I Timing" )

	#	First stop the current run if still active
	field( DLY0, "0.1" ) field( DOL0, "1" ) field( LNK0, "$(PGP):ChAll:SeqStopRun.PROC  PP NMS" )
  
  # Assert TxPhyReset for 1 sec
  field( DLY1, "0"   ) field( DOL1, "1" ) field( LNK1, "$(PGP):Timing:TxPhyReset    PP NMS" )
  field( DLY2, "1"   ) field( DOL2, "0" ) field( LNK2, "$(PGP):Timing:TxPhyReset    PP NMS" )

	# Disable MiniTpg and set ModeSelEn to UseClkSel
	field( DLY3, "0.1" ) field( DOL3, "0" ) field( LNK3, "$(PGP):Timing:UseMiniTpg    PP NMS" )
	field( DLY4, "0.1" ) field( DOL4, "0" ) field( LNK4, "$(PGP):Timing:ModeSelEn     PP NMS" )

	# Assert RxPllReset for 1 sec 
	field( DLY5, "0"   ) field( DOL5, "1" ) field( LNK5, "$(PGP):Timing:RxPllReset    PP NMS" )
	field( DLY6, "1"   ) field( DOL6, "0" ) field( LNK6, "$(PGP):Timing:RxPllReset    PP NMS" )

	# Select LCLS-I Clock
	field( DLY7, "0.1" ) field( DOL7, "0" ) field( LNK7, "$(PGP):Timing:ClkSel        PP NMS" )
	field( DLY8, "0.1" ) field( DOL8, "0" ) field( LNK8, "$(PGP):Timing:ModeSel       PP NMS" )

	# Assert C_RxReset for 1 sec 
	field( DLY9, "0"   ) field( DOL9, "1" ) field( LNK9, "$(PGP):Timing:C_RxReset     PP NMS" )
	field( DLYA, "1"   ) field( DOLA, "0" ) field( LNKA, "$(PGP):Timing:C_RxReset     PP NMS" )

	# Assert RxUserRst for 1 sec 
	field( DLYB, "0"   ) field( DOLB, "1" ) field( LNKB, "$(PGP):Timing:RxUserRst     PP NMS" )
	field( DLYC, "1"   ) field( DOLC, "0" ) field( LNKC, "$(PGP):Timing:RxUserRst     PP NMS" )

	# Reset the latching register
	field( DLYD, "0.1" ) field( DOLD, "0" ) field( LNKD, "$(PGP):Timing:RxDown        PP NMS" )
	
  # Set rate related & other PVs 
	field( DLYE, "0.1" ) field( DOLE, "1" ) field( LNKE, "$(PGP):SetLcls1Rates.PROC   PP NMS" )

	info( autosaveFields, "DESC" )
}

