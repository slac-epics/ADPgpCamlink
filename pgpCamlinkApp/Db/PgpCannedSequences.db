record( seq, "$(PGP):SetLcls1Rates" )
{
	field( DESC, "Select LCLS-I Timing" )

	# Set EventBuilder Bypass to mask out XPM Timing Message for LCLS1 timing 
	field( DLY0, "0.1" ) field( DOL0, "1" ) field( LNK0, "$(PGP):ChAll:EventBuilder:BypassXPM.PROC  PP NMS" )

	# Set RateType to ControlWord for LCLS1 timing rates
	field( DLY1, "0.1" ) field( DOL1, "1" ) field( LNK1, "$(PGP):ChAll:EvrV2:RateTypeControlWord.PROC PP NMS" )

	# Set RateSel for each channel to that channel's LCLS1 timing rate
	field( DLY2, "0.1" ) field( DOL2, "1" ) field( LNK2, "$(PGP):ChAll:Lcls1:RateSel.PROC  PP NMS" )

	# Set TriggerSource for each channel to EVR
	field( DLY3, "0.1" ) field( DOL3, "1" ) field( LNK3, "$(PGP):ChAll:Evr:Timing:TriggerSource.PROC  PP NMS" )

	info( autosaveFields, "DESC" )
}

record( seq, "$(PGP):SetTpgMiniRates" )
{
	field( DESC, "Select TpgMini Internal LCLS-I Clock" )

	# Set EventBuilder Bypass to mask out XPM Timing Message for LCLS1 timing 
	field( DLY0, "0.1" ) field( DOL0, "1" ) field( LNK0, "$(PGP):ChAll:EventBuilder:BypassXPM.PROC  PP NMS" )

	# Set RateType to ControlWord for LCLS1 timing rates
	field( DLY1, "0.1" ) field( DOL1, "1" ) field( LNK1, "$(PGP):ChAll:EvrV2:RateTypeControlWord.PROC PP NMS" )

	# Set RateSel for each channel to that channel's LCLS1 timing rate
	field( DLY2, "0.1" ) field( DOL2, "1" ) field( LNK2, "$(PGP):ChAll:Lcls1:RateSel.PROC  PP NMS" )
	
  # Set TriggerSource for each channel to TpgMini/XPM 
	field( DLY3, "0.1" ) field( DOL3, "1" ) field( LNK3, "$(PGP):ChAll:Xpm:Timing:TriggerSource.PROC  PP NMS" )

	# Enable MiniTpg
	field( DLY4, "0.1" ) field( DOL4, "1" ) field( LNK4, "$(PGP):Timing:UseMiniTpg    PP NMS" )

	info( autosaveFields, "DESC" )
}

record( seq, "$(PGP):SetLcls2Rates" )
{
	field( DESC, "Select LCLS-II Timing" )

	# Set EventBuilder Bypass to mask out XPM Timing Message for LCLS2 timing 
	field( DLY0, "0.1" ) field( DOL0, "1" ) field( LNK0, "$(PGP):ChAll:EventBuilder:BypassXPM.PROC  PP NMS" )

	# Set RateType to ControlWord for LCLS2 timing rates
	field( DLY1, "0.1" ) field( DOL1, "1" ) field( LNK1, "$(PGP):ChAll:EvrV2:RateTypeFixedRates.PROC PP NMS" )

	# Set RateSel for each channel to that channel's LCLS2 timing rate
	field( DLY2, "0.1" ) field( DOL2, "1" ) field( LNK2, "$(PGP):ChAll:Lcls2:RateSel.PROC  PP NMS" )

	# Set TriggerSource for each channel to EVR
	field( DLY3, "0.1" ) field( DOL3, "1" ) field( LNK3, "$(PGP):ChAll:Evr:Timing:TriggerSource.PROC  PP NMS" )

	info( autosaveFields, "DESC" )
}

record( seq, "$(PGP):SetXpmMiniRates" )
{
	field( DESC, "Select XpmMini Internal LCLS-II Clock" )

	# Set EventBuilder Bypass to mask out XPM Timing Message for LCLS2 timing 
	field( DLY0, "0.1" ) field( DOL0, "1" ) field( LNK0, "$(PGP):ChAll:EventBuilder:Bypass.PROC  PP NMS" )

	# Set RateType to FixedRates for LCLS2 timing rates
	field( DLY1, "0.1" ) field( DOL1, "1" ) field( LNK1, "$(PGP):ChAll:EvrV2:RateTypeFixedRates.PROC PP NMS" )

	# Set RateSel for each channel to that channel's LCLS2 timing rate
	field( DLY2, "0.1" ) field( DOL2, "1" ) field( LNK2, "$(PGP):ChAll:Lcls2:RateSel.PROC  PP NMS" )

	# Enable MiniTpg
	field( DLY3, "0.1" ) field( DOL3, "1" ) field( LNK3, "$(PGP):Timing:UseMiniTpg    PP NMS" )
	field( DLY4, "0.1" ) field( DOL4, "1" ) field( LNK4, "$(PGP):XpmMini:HwEnable     PP NMS" )
	field( DLY5, "0.1" ) field( DOL5, "0" ) field( LNK5, "$(PGP):XpmMini:Link         PP NMS" )
	
  # Set TriggerSource for each channel to TpgMini/XPM 
	field( DLY6, "0.1" ) field( DOL6, "1" ) field( LNK6, "$(PGP):ChAll:Xpm:Timing:TriggerSource.PROC  PP NMS" )

	# Select XpmMini rate
	field( DLY7, "0.1" ) field( DOL7, "5" ) field( LNK7, "$(PGP):XpmMini:Config_L0Select_RateSel PP NMS" )

	# Enable XpmMini Select
	field( DLY8, "0.1" ) field( DOL8, "1" ) field( LNK8, "$(PGP):XpmMini:Config_L0Select_Enabled PP NMS" )

	info( autosaveFields, "DESC" )
}

record( dfanout, "$(PGP):ChAll:EventBuilder:BypassXPM" )
{
	field( DESC, "Bypass XPM DAQ msgs in EventBuilder" )
	field( DOL,  "4" )
	field( OUTA, "$(PGP):Ch0:EventBuilder:Bypass  PP NMS" )
	field( OUTB, "$(PGP):Ch1:EventBuilder:Bypass  PP NMS" )
	field( OUTC, "$(PGP):Ch2:EventBuilder:Bypass  PP NMS" )
	field( OUTD, "$(PGP):Ch3:EventBuilder:Bypass  PP NMS" )
}

record( dfanout, "$(PGP):ChAll:EventBuilder:Bypass" )
{
	field( DESC, "Bypass XPM DAQ msgs in EventBuilder" )
	field( DOL,  "0" )
	field( OUTA, "$(PGP):Ch0:EventBuilder:Bypass  PP NMS" )
	field( OUTB, "$(PGP):Ch1:EventBuilder:Bypass  PP NMS" )
	field( OUTC, "$(PGP):Ch2:EventBuilder:Bypass  PP NMS" )
	field( OUTD, "$(PGP):Ch3:EventBuilder:Bypass  PP NMS" )
}

