# Camlink Configuration
# When the user selects a new configuration, we set the following:
# 1. Tap geometry in camera & taps in framegrabber
# 2. Pixel depth in camera and data mode in FEB
# 3. CL output mode in camera and framegrabber
# 4. Pixel clock in camera and framegrabber

record( mbbo, "$(P)$(R)JaiCLConfig" )
{
	field( DOL,  "4" )
	field( ZRVL, "0" ) field( ZRST, "Base 2 taps" )
	field( ONVL, "1" ) field( ONST, "Base 3 taps" )
	field( TWVL, "2" ) field( TWST, "Medium" )
	field( THVL, "3" ) field( THST, "Full" )
	field( FRVL, "4" ) field( FRST, "DECA" )
	field( FLNK, "$(P)$(R)CLConfigSelSeq" )
	info( autosaveFields, "VAL" )
}

record( mbbi, "$(P)$(R)JaiCLConfig_RBV" )
{
	field( INP, "$(P)$(R)JaiCLConfig CPP MS" )
    field( ZRVL, "0" ) field( ZRST, "Base 2 taps" )
	field( ONVL, "1" ) field( ONST, "Base 3 taps" )
	field( TWVL, "2" ) field( TWST, "Medium" )
	field( THVL, "3" ) field( THST, "Full" )
	field( FRVL, "4" ) field( FRST, "DECA" )
	info( autosaveFields, "VAL" )
}

record( fanout, "$(P)$(R)CLConfigSelSeq" )
{
	field( SELL, "$(P)$(R)JaiCLConfig.RVAL" )
	field( SELM, "Specified" )
	field( LNK0, "$(P)$(R)SeqCLConfigBase2"  )
	field( LNK1, "$(P)$(R)SeqCLConfigBase3"  )
	field( LNK2, "$(P)$(R)SeqCLConfigMedium" )
	field( LNK3, "$(P)$(R)SeqCLConfigFull"   )
	field( LNK4, "$(P)$(R)SeqCLConfigDeca"   )
}

record( seq, "$(P)$(R)SeqCLConfigBase2" )
{
	#	Stop aquisition triggers
	field( DLY0, "0" ) field( DOL0, "0" ) field( LNK0, "$(P)$(R)Acquire  PP NMS" )

	field( DESC, "Base Mode: 31.9fps, 12 bits, 2 taps" )
	field( DLY2, "1.0" ) field( DOL2, "1" ) field( LNK2, "$(P)$(R)CLPixelClock PP NMS" )
	field( DLY3, "1.0" ) field( DOL3, "1" ) field( LNK3, "$(P)$(R)JaiTapGeometry PP NMS" )
	field( DLY4, "1.0" ) field( DOL4, "2" ) field( LNK4, "$(P)$(R)JaiPixelFormat PP NMS" )
	field( DLY5, "1.0" ) field( DOL5, "2" ) field( LNK5, "$(P)$(R)CLPixelClock PP NMS" )
	field( DLY6, "0.5" ) field( DOL6, "3" ) field( LNK6, "$(P)$(R)CamlinkDataMode" )
	field( DLY7, "0.5" ) field( DOL7, "1" ) field( LNK7, "$(P)$(R)CamlinkLinkMode" )
	field( DLY8, "0.5" ) field( DOL8, "2" ) field( LNK8, "$(P)$(R)CamlinkHTap" )
}

