	field( DLY4, "0.2" ) field( DOL4, "1" ) field( LNK4, "$(P)$(R)CamlinkLinkMode PP" )
	field( DLY5, "0.2" ) field( DOL5, "1" ) field( LNK5, "$(P)$(R)CamlinkDataMode PP" )
	field( DLY6, "0.2" ) field( DOL6, "3" ) field( LNK6, "$(P)$(R)CamlinkHTap PP" )
	field( DLY7, "0.2" ) field( DOL7, "0" ) field( LNK7, "$(PGP):Ch$(PGP_LANE):Feb$(PGP_LANE):ClinkDecaMode PP" )
	field( DLY8, "1"   ) field( DOL8, "1" ) field( LNK8, "$(PGP):Ch$(PGP_LANE):Feb$(PGP_LANE):RstPll PP" )
	field( DLY9, "1"   ) field( DOL9, "0" ) field( LNK9, "$(PGP):Ch$(PGP_LANE):Feb$(PGP_LANE):RstPll PP" )
