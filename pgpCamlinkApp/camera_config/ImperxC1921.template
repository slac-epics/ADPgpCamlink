	field( OMSL,	"closed_loop" )
	field( DTYP,	"stream" )
	field( OUT,     "@ImperxC1921.proto SetAnalogGain($(P)$(R)) $(PORT).SER" )
	field( DRVH,	"480" )
	field( DRVL,	"0" )
	field( HOPR,	"480" )
	field( LOPR,	"0" )
