    field( FLNK,	"$(P)$(R)ImperxCalcGain_RBV" )
}

# Use mathematical identity for the CALC field: 10^A=e^(A⋅ln(10))
record( calcout, "$(P)$(R)ImperxCalcGain_RBV" )
{
	field( INPA, "$(P)$(R)ImperxGain_RBV NPP NMS" )
	field( CALC, "EXP((0.1*A/20)*LN(10))" )
	field( OUT,  "$(P)$(R)CamGain_RBV PP MS" )
	field( PREC, "2" )
}

